                    c().SnapBaseY = RootPart.Position.Y
                end
                local targetY = c().SnapBaseY - (c().SnapAmount or 10)
                local deltaY = targetY - RootPart.Position.Y
                Character:PivotTo(RootPart.CFrame * CFrame.new(0, deltaY, 0))
            end, warn)
        else
            c().SnapBaseY = nil
        end
    end
end)

