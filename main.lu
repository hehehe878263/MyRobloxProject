local Character = Client.Character or Client.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local RootPart = Character:WaitForChild("HumanoidRootPart")
local CurrentCamera = workspace.CurrentCamera

Client.CharacterAdded:Connect(function(newChar)
    Character = newChar
    Humanoid = Character:WaitForChild("Humanoid")
    RootPart = Character:WaitForChild("HumanoidRootPart")
end)

local Char = require(ReplicatedStorage.Modules.Core.Char)
local SprintModule = require(ReplicatedStorage.Modules.Game.Sprint)
local Network = require(ReplicatedStorage.Modules.Core.Net)
local RagdollModule = require(ReplicatedStorage.Modules.Game.Ragdoll)

local DroppedFolder = workspace:FindFirstChild('DroppedItems')

local RarityData = {
    Common = Color3.fromRGB(255,255,255),
    Uncommon = Color3.fromRGB(99,255,52),
    Rare = Color3.fromRGB(51,170,255),
    Epic = Color3.fromRGB(237,44,255),
    Legendary = Color3.fromRGB(255,150,0),
    Omega = Color3.fromRGB(255,20,51)
}

local TracerColors = {
    Red = Color3.fromRGB(255,0,0),
    Orange = Color3.fromRGB(255,140,0),
    Yellow = Color3.fromRGB(255,255,0),
    Blue = Color3.fromRGB(0,150,255),
    Navy = Color3.fromRGB(0,0,180),
    Black = Color3.fromRGB(20,20,20),
    White = Color3.fromRGB(255,255,255),
    Purple = Color3.fromRGB(180,0,255),
    Pink = Color3.fromRGB(255,105,180),
    Green = Color3.fromRGB(0,255,0)
}

local function GetDistanceRoot(obj)
    if not RootPart or not RootPart.Parent then return 0 end
    if typeof(obj) == "Instance" then
        if obj:IsA("BasePart") then return (obj.Position - RootPart.Position).Magnitude
        elseif obj:IsA("Model") then return (obj:GetPivot().Position - RootPart.Position).Magnitude end
    elseif typeof(obj) == "Vector3" then
        return (obj - RootPart.Position).Magnitude
    end
    return 0
end

local function IsAlive(model)
    if not model then return false end
    local h = model:FindFirstChildOfClass('Humanoid')
    if not h then return false end
    local r = model:FindFirstChild('HumanoidRootPart')
    if not r then return false end
    return h.Health > 0
end

local function Draw(t, props)
    local o = Drawing.new(t)
    for k, v in pairs(props or {}) do o[k] = v end
    return o
end

local function W2V(obj)
    local pos = typeof(obj) == "Vector3" and obj or obj.Position
    return CurrentCamera:WorldToViewportPoint(pos)
end

local function DistStart(a, b)
    if typeof(a) == "Vector2" and typeof(b) == "Vector2" then return (a-b).Magnitude end
    return math.huge
end

local function SortAttr(inst)
    local k = {}
    for key in pairs(inst:GetAttributes()) do table.insert(k, key) end
    table.sort(k)
    return k
end

local function solveQ(A,B,C)
    local d = B*B - 4*A*C
    if d < 0 then return nil, nil end
    local s = math.sqrt(d)
    return (-B - s)/(2*A), (-B + s)/(2*A)
end

local function flightTime(dir, grav, speed)
    local r1, r2 = solveQ(grav:Dot(grav)/3.8, grav:Dot(dir) - speed*speed, dir:Dot(dir))
    if r1 and r2 then
        if r1 > 0 and r1 < r2 then return math.sqrt(r1)
        elseif r2 > 0 and r2 < r1 then return math.sqrt(r2) end
    end
    return 0
end

local function countT(t)
    local n = 0
    for _ in pairs(t) do n = n + 1 end
    return n
end

local function makeHex(seg)
    seg = seg or 6
    local l = {}
    for i = 1, seg do
        l[i] = Draw("Line", { Visible = false, Color = Color3.fromRGB(255,255,255), Thickness = 1.5, Transparency = 1 })
    end
    return l
end

local function updateHex(hex, center, radius, visible, color, rotation)
    rotation = rotation or 0
    local n = countT(hex)
    for i = 1, n do
        local a1 = math.rad((i-1) * (360/n) - 90 + rotation)
        local a2 = math.rad(i * (360/n) - 90 + rotation)
        local p1 = Vector2.new(center.X + math.cos(a1)*radius, center.Y + math.sin(a1)*radius)
        local p2 = Vector2.new(center.X + math.cos(a2)*radius, center.Y + math.sin(a2)*radius)
        hex[i].From = p1
        hex[i].To = p2
        hex[i].Color = color
        hex[i].Visible = visible
    end
end

local function removeHex(hex)
    if hex then
        for _, l in pairs(hex) do
            if l.Remove then l:Remove() end
        end
    end
end

local DrawingsData = { Players = {}, Item = {} }
local AimHex = makeHex(6)
local AimHexRadius = 200

local function createPD(player)
    return {
        Name = Draw("Text", { Visible = false, Color = Color3.new(1,1,1), Size = 15, Center = true, Outline = true, OutlineColor = Color3.new(0,0,0) }),
        Distance = Draw("Text", { Visible = false, Color = Color3.new(1,1,1), Size = 14, Center = true, Outline = true, OutlineColor = Color3.new(0,0,0) }),
        BoxAround = Draw("Square", { Visible = false, Color = Color3.fromRGB(201,12,204), Thickness = 1, Transparency = 1, Filled = false }),
        HpBar = Draw("Line", { Visible = false, Color = Color3.new(0,1,0), Thickness = 2 }),
        TargetHex = makeHex(6),
        AimTracer = Draw("Line", { Visible = false, Color = Color3.fromRGB(255,0,0), Thickness = 1.5 })
    }
end

for _, v in pairs(Players:GetPlayers()) do
    if v ~= Client then
        DrawingsData.Players[v] = createPD(v)
        DrawingsData.Players[v].Name.Text = v.Name
    end
end

