local HexRot = 0
local ItemHexRot = 0
RunService.RenderStepped:Connect(function(dt)
    HexRot = HexRot + dt * 60
    if HexRot >= 360 then HexRot = HexRot - 360 end
    ItemHexRot = ItemHexRot + dt * 90
    if ItemHexRot >= 360 then ItemHexRot = ItemHexRot - 360 end

    AimHexRadius = c().PovSize or 200
    local center = Vector2.new(CurrentCamera.ViewportSize.X/2, CurrentCamera.ViewportSize.Y/2)
    local hexColor = c().RainbowPov and Color3.fromHSV((tick()%5)/5, 1, 1) or Color3.fromRGB(255,255,255)
    updateHex(AimHex, center, AimHexRadius, c().AimAssiant or false, hexColor, HexRot)

    for _, d in pairs(DrawingsData.Players) do
        d.AimTracer.Visible = false
        d.BoxAround.Visible = false
        d.HpBar.Visible = false
        if d.TargetHex then
            for _, l in pairs(d.TargetHex) do l.Visible = false end
        end
    end

    local closest, closestDist = nil, math.huge
    for _, targetChar in pairs(Char.get_all()) do
        if targetChar ~= Character and IsAlive(targetChar) then
            local tp = Players:GetPlayerFromCharacter(targetChar)
            if tp and not tp:GetAttribute("InMenuCharacterCreator") and not tp:GetAttribute("InSplashScreen") and not tp:GetAttribute('IsSafeZoneProtected') and not targetChar:GetAttribute('IsSpawnProtected') then
                local root = targetChar:FindFirstChild("HumanoidRootPart")
                if root then
                    local sp, onScreen = W2V(root)
                    if onScreen then
                        local v2 = Vector2.new(sp.X, sp.Y)
                        local ds = DistStart(v2, center)
                        if ds <= AimHexRadius and ds < closestDist then
                            closest = targetChar
                            closestDist = ds
                        end
                    end
                end
            end
        end
    end
    c().AimAssiantTarget = closest

    if closest then
        local tp = Players:GetPlayerFromCharacter(closest)
        if tp then
            local d = DrawingsData.Players[tp]
            if d then
                local targetPart = closest:FindFirstChild((c().PartTargetSelected or "Head"))
                if targetPart then
                    local ps, onScreen = W2V(targetPart)
                    if onScreen then
                        local tCol = TracerColors[c().TracerColor or "Red"] or TracerColors.Red
                        d.AimTracer.Color = tCol
                        d.AimTracer.Thickness = c().TracerThickness or 1.5
                        d.AimTracer.Visible = (c().AimAssiant and c().ShowTracer) or false
                        d.AimTracer.From = center
                        d.AimTracer.To = Vector2.new(ps.X, ps.Y)
                        local targetRadius = math.clamp(1200 / ps.Z, 8, 40)
                        updateHex(d.TargetHex, Vector2.new(ps.X, ps.Y), targetRadius, (c().AimAssiant or false) and onScreen, tCol, HexRot)
                    end
                end
            end
        end
    end

    for po, d in pairs(DrawingsData.Players) do
        if po and IsAlive(po.Character) then
            local charP = po.Character
            local head = charP:FindFirstChild('Head')
            local root = charP:FindFirstChild('HumanoidRootPart')
            local hum = charP:FindFirstChildOfClass('Humanoid')
            if head and root and hum then
                local ph, onScreen = W2V(head.Position + Vector3.new(0, 0.5, 0))
                if onScreen then
                    d.Name.Position = Vector2.new(ph.X, ph.Y - 22)
                    d.Name.Text = po.Name
                    d.Name.Visible = c().NamePlayerVisual or false
                    local pLeg = W2V(root.Position - Vector3.new(0, 3, 0))
                    local pRoot = W2V(root)
                    local scaleR = 1000 / pRoot.Z
                    d.BoxAround.Size = Vector2.new(scaleR, ph.Y - pLeg.Y)
                    d.BoxAround.Position = Vector2.new(pRoot.X - d.BoxAround.Size.X / 2, pRoot.Y - d.BoxAround.Size.Y / 2)
                    d.BoxAround.Visible = c().BoxPlayerVisual or false
                    d.BoxAround.Color = po:GetAttribute('IsSafeZoneProtected') and Color3.fromRGB(7,255,44) or charP:GetAttribute('IsSpawnProtected') and Color3.fromRGB(3,41,255) or Color3.fromRGB(201,12,204)
                    d.Distance.Text = "[" .. math.floor(GetDistanceRoot(root)) .. "m]"
                    d.Distance.Position = Vector2.new(ph.X, pLeg.Y + 5)
                    d.Distance.Visible = c().DistancePlayerVisual or false
                    local hp = hum.Health / hum.MaxHealth
                    d.HpBar.From = Vector2.new(d.BoxAround.Position.X + d.BoxAround.Size.X + 5, d.BoxAround.Position.Y + d.BoxAround.Size.Y * (1 - hp))
                    d.HpBar.To = Vector2.new(d.BoxAround.Position.X + d.BoxAround.Size.X + 5, d.BoxAround.Position.Y + d.BoxAround.Size.Y)
                    d.HpBar.Color = Color3.new(1 - hp, hp, 0)
                    d.HpBar.Visible = c().HealthPlayerVisual or false
                else
                    d.Name.Visible = false
                    d.Distance.Visible = false
                    d.BoxAround.Visible = false
                    d.HpBar.Visible = false
                end
            else
                d.Name.Visible = false
                d.Distance.Visible = false
                d.BoxAround.Visible = false
                d.HpBar.Visible = false
            end
        else
            d.Name.Visible = false
            d.Distance.Visible = false
            d.BoxAround.Visible = false
            d.HpBar.Visible = false
        end
    end

    for dropItem, _ in pairs(DrawingsData.Item) do
        if not dropItem or not dropItem.Parent then
            local data = DrawingsData.Item[dropItem]
            if data then
                removeHex(data.Hex)
                if data.NameItem then data.NameItem:Remove() end
                if data.Distance then data.Distance:Remove() end
            end
            DrawingsData.Item[dropItem] = nil
        end
    end

    if DroppedFolder then
        for _, dropObj in pairs(DroppedFolder:GetChildren()) do
            if dropObj:IsA("Model") and dropObj:FindFirstChild("PickUpZone") and not dropObj:GetAttribute("Locked") then
                if not DrawingsData.Item[dropObj] then
                    DrawingsData.Item[dropObj] = {
                        Hex = makeHex(6),
                        NameItem = Draw("Text", { Color = Color3.fromRGB(255,255,255), Outline = true, Center = true, Size = 14 }),
                        Distance = Draw("Text", { Color = Color3.fromRGB(255,255,255), Outline = true, Center = true, Size = 13 })
                    }
                end
            end
        end
    end

    for itemObj, d in pairs(DrawingsData.Item) do
        local pz = itemObj:FindFirstChild("PickUpZone")
        if pz then
            local p2d, onScreen = W2V(pz)
            if onScreen then
                local iType = itemObj:GetAttribute("item_type")
                local rar
                local iF = iType and ReplicatedStorage:FindFirstChild("Items") and ReplicatedStorage.Items:FindFirstChild(iType)
                if iF then
                    local it = iF:FindFirstChild(itemObj.Name)
                    if it then rar = it:GetAttribute("RarityName") end
                end
                local bl = c().BlacklistRarityDropVisual
                if type(bl) ~= "table" then bl = {} end
                local blC = countT(bl)
                local isBL = table.find(bl, rar) ~= nil
                local visible = (c().ItemDropVisual or false) and (itemObj.Name == "Money" or blC == 0 or not isBL)
                local col = RarityData[rar] or Color3.fromRGB(255,255,255)
                local dist = GetDistanceRoot(pz)
                local radius = math.clamp(300/math.max(dist,1), 10, 45)
                updateHex(d.Hex, p2d, radius, visible, col, ItemHexRot)
                d.NameItem.Text = itemObj.Name
                d.NameItem.Position = Vector2.new(p2d.X, p2d.Y - radius - 14)
                d.NameItem.Visible = visible
                local attrs = SortAttr(itemObj)
                local qK = attrs[5]
                d.Distance.Text = "[x" .. tostring(qK and itemObj:GetAttribute(qK) or "?") .. "]"
                d.Distance.Position = Vector2.new(p2d.X, p2d.Y + radius + 4)
                d.Distance.Visible = visible
            else
                for _, l in pairs(d.Hex) do l.Visible = false end
                d.NameItem.Visible = false
                d.Distance.Visible = false
            end
        end
    end

    for _, v in pairs(Char.get_all()) do
        if v ~= Character and IsAlive(v) then
            local root = v:FindFirstChild('HumanoidRootPart')
            local gp = Players:GetPlayerFromCharacter(v)
            if gp and root then
                if not root:FindFirstChild('ItemInventoryViewer') then
                    local viewer = Instance.new('BillboardGui')
                    viewer.Name = "ItemInventoryViewer"
                    viewer.AlwaysOnTop = true
                    viewer.Adornee = root
                    viewer.Size = UDim2.new(0, 200, 0, 30)
                    viewer.StudsOffset = Vector3.new(0, 4, 0)
                    viewer.Parent = root
                    local bg = Instance.new('Frame')
                    bg.Name = "BackgroundFrame"
                    bg.BackgroundTransparency = 1
                    bg.Size = UDim2.new(1,0,1,0)
                    bg.AnchorPoint = Vector2.new(0.5,0.5)
                    bg.Position = UDim2.new(0.5,0,0.5,0)
                    bg.Parent = viewer
                    local ll = Instance.new('UIListLayout')
                    ll.FillDirection = Enum.FillDirection.Horizontal
                    ll.HorizontalAlignment = Enum.HorizontalAlignment.Center
                    ll.VerticalAlignment = Enum.VerticalAlignment.Center
                    ll.Padding = UDim.new(0, 5)
                    ll.Parent = bg
                end
                local inv = {}
                local viewer = root:FindFirstChild('ItemInventoryViewer')
                local bg = viewer and viewer:FindFirstChild('BackgroundFrame')
                if bg then
                    for _, cont in pairs({gp.Backpack, v}) do
                        if cont then
                            for _, tool in pairs(cont:GetChildren()) do
                                if tool:IsA("Tool") and not tool:GetAttribute("JobTool") and not tool:GetAttribute("Locked") then
                                    local iFold = (function()
                                        local at = tool:GetAttributes()
                                        for _, val in pairs(at) do
                                            if type(val) == "string" and val:lower():find("melee") then
                                                return ReplicatedStorage.Items.melee:GetChildren()
                                            end
                                        end
                                        if at.AmmoType and at.Recoil then
                                            return ReplicatedStorage.Items.gun:GetChildren()
                                        end
                                        return ReplicatedStorage.Items.throwable:GetChildren()
                                    end)()
                                    for _, iRS in pairs(iFold) do
                                        if tool:GetAttribute("RarityName") == iRS:GetAttribute("RarityName") and tool:GetAttribute("RarityPrice") == iRS:GetAttribute("RarityPrice") then
                                            local imgId = iRS:GetAttribute("ImageId")
                                            if imgId then
                                                inv[iRS.Name] = true
                                                if not bg:FindFirstChild(iRS.Name) then
                                                    local ico2 = Instance.new('ImageLabel')
                                                    ico2.Name = iRS.Name
                                                    ico2.Image = 'rbxassetid://137066731814190'
                                                    ico2.BackgroundTransparency = 1
                                                    ico2.BorderSizePixel = 0
                                                    ico2.ImageColor3 = RarityData[tool:GetAttribute("RarityName")] or Color3.fromRGB(255,255,255)
                                                    ico2.Size = UDim2.new(0,25,0,25)
                                                    ico2.Parent = bg
                                                    local icoB = Instance.new('ImageLabel')
                                                    icoB.Name = "IconBase"
                                                    icoB.Image = imgId
                                                    icoB.BackgroundTransparency = 1
                                                    icoB.BorderSizePixel = 0
                                                    icoB.Size = UDim2.new(0.9,0,0.9,0)
                                                    icoB.AnchorPoint = Vector2.new(0.5,0.5)
                                                    icoB.Position = UDim2.new(0.5,0,0.5,0)
                                                    icoB.Parent = ico2
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                    viewer.Enabled = (c().InventoryPlayerVisual and v:FindFirstChild('Humanoid').Health > 0) or false
                    for _, obj in pairs(bg:GetChildren()) do
                        if obj:IsA("ImageLabel") and not inv[obj.Name] then
                            obj:Destroy()
                        end
                    end
                end
            end
        end
    end
end)

local TargetHistory = {}
local OldSend
OldSend = hookfunction(Network.send, function(...)
    local args = {...}
    if args[1] == "shoot_gun" and c().AimAssiant and c().AimAssiantTarget then
        local tp = c().AimAssiantTarget:FindFirstChild((c().PartTargetSelected or "Head"))
        if tp then
            local cp = RootPart.Position
            local tPos = tp.Position
            local vec = tPos - cp
            local now = tick()
            local grav = Vector3.new(0, -workspace.Gravity, 0)
            local speed = 1000
            local tt = flightTime(vec, grav, speed)
            TargetHistory[c().AimAssiantTarget] = TargetHistory[c().AimAssiantTarget] or {}
            if countT(TargetHistory[c().AimAssiantTarget]) >= 3 then table.remove(TargetHistory[c().AimAssiantTarget], 1) end
            table.insert(TargetHistory[c().AimAssiantTarget], {pos = tPos, time = now})
            local hist = TargetHistory[c().AimAssiantTarget]
            local hC = countT(hist)
            local vel = Vector3.zero
            if hC == 2 then
                local p1, p2 = hist[1], hist[2]
                local dt = math.max(p2.time - p1.time, 1e-6)
                vel = (p2.pos - p1.pos)/dt
            elseif hC >= 3 then
                local p2, p3 = hist[hC-1], hist[hC]
                local dt2 = math.max(p3.time - p2.time, 1e-6)
                vel = (p3.pos - p2.pos)/dt2
            end
            local predPos = tPos + vel * tt + Vector3.new(0, 0.001 * grav.Y * (tt*tt), 0)
            args[3] = CFrame.new(cp, predPos)
            if args[4] then
                for _, v in pairs(args[4]) do
                    for _, x in pairs(v) do
                        x.Normal = Vector3.new(0, 1, 0)
                        x.Position = predPos
                        x.Instance = tp
                    end
                end
            end
            if c().ShowTracer then
                local dT = (predPos - cp).Magnitude
                if dT > 0.1 then
                    local tCol = TracerColors[c().TracerColor or "Red"] or TracerColors.Red
                    local tr = Instance.new("Part", workspace)
                    tr.Size = Vector3.new(0.05, 0.05, dT)
                    tr.Color = tCol
                    tr.CFrame = CFrame.new(cp, predPos) * CFrame.new(0, 0, -dT/2)
                    tr.Material = Enum.Material.Neon
                    tr.CanCollide = false
                    tr.Anchored = true
                    Debris:AddItem(tr, c().TracerDuration or 0.4)
                end
            end
        end
    end
    return OldSend(table.unpack(args))
end)

do
    local cs = SprintModule.consume_stamina
    local sb = debug.getupvalue(cs, 2).sprint_bar
    local ou = sb.update
    sb.update = function(...)
        if c().InfStamina then return (function() return 1 end) end
        return ou(...)
    end
end

do
    local gr = RagdollModule.is_ragdolling.get
    RagdollModule.is_ragdolling.get = function(...)
        local res = gr(...)
        if res == true and c().AntiRagdoll then
            RagdollModule.is_ragdolling.set(false)
            Network.send("end_ragdoll_early")
            Network.send("clear_ragdoll")
        end
        return res
    end
end

local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()

local ConfigMgr = loadstring(game:HttpGet("https://raw.githubusercontent.com/Yenixs/ToolScript/refs/heads/main/ConfigManager.luau"))()('DarkPower_Blockspin', c())
ConfigMgr.SC()

local Window = WindUI:CreateWindow({
    Title = "Dark Power | Blockspin",
    Icon = "rbxassetid://120071332053245",
    Author = "Dark Power Hub",
    Folder = "DarkPower",
    Size = UDim2.fromOffset(520, 460),
    Theme = "Dark",
    Transparent = true,
    Resizable = true,
})

Window:Tag({ Title = "Dark Power", Icon = "zap", Color = Color3.fromHex("#ff3060"), Radius = 10 })

UserInputService.InputBegan:Connect(function(i, gp)
    if not gp and i.KeyCode == Enum.KeyCode.T then Window:Toggle() end
end)

local Tabs = {
    General = Window:Tab({Title = "General", Icon = "library"}),
    Pvp = Window:Tab({Title = "PVP", Icon = "crosshair"}),
    Visual = Window:Tab({Title = "Visual", Icon = "eye"}),
    Vehicle = Window:Tab({Title = "Vehicle", Icon = "car"}),
    Config = Window:Tab({Title = "Config", Icon = "save"})
}
Tabs.General:Select()

local function Section(Tab, Text)
    return Tab:Section({ Title = Text, Box = false, TextSize = 17, Opened = true })
end

local function Tg(def, Tab, Title, Keys)
    local t = Tab:Toggle({
        Title = Title,
        Value = c()[Keys] or def,
        Callback = function(s)
            ConfigMgr.S()[Keys] = s
            c()[Keys] = s
            ConfigMgr.SG()
        end
    })
    if t then t.Callback(c()[Keys]) end
    return t
end

local function Slider(Tab, Title, Steps, Mins, Maxs, Def, Keys)
    local s = Tab:Slider({
        Flag = Title,
        Title = Title,
        Step = Steps,
        Value = { Min = Mins, Max = Maxs, Default = c()[Keys] or Def },
        Callback = function(v)
            ConfigMgr.S()[Keys] = v
            c()[Keys] = v
            ConfigMgr.SG()
        end
    })
    if s then s.Callback(c()[Keys] or Def) end
    return s
end

local function Dropdown(Tab, Title, Keys, Values, Multi)
    local d = Tab:Dropdown({
        Title = Title,
        Values = Values,
        Multi = Multi or false,
        AllowNone = true,
        Value = c()[Keys] or (Multi and {} or Values[1]),
        Callback = function(o)
            ConfigMgr.S()[Keys] = o
            c()[Keys] = o
            ConfigMgr.SG()
        end
    })
    if d and d.Callback then d.Callback(c()[Keys] or (Multi and {} or Values[1])) end
    return d
end

local function Btn(Tab, Title, Desc, Callback)
    return Tab:Button({ Title = Title, Desc = Desc or "", Callback = Callback or function() end })
end

local hSec = Section(Tabs.General, "Humanoid")
Tg(false, hSec, "ปรับความเร็ว", "WalkSpeedCustom")
Slider(hSec, "ค่าความเร็ว", 0.1, 1, 5, 1, "WalkSpeedValue")
Tg(false, hSec, "ปรับการกระโดด", "JumpPowerCustom")
Slider(hSec, "ค่ากระโดด", 1, 1, 25, 10, "JumpPowerValue")

local sSec = Section(Tabs.General, "มุดดิน")
Tg(false, sSec, "เปิดมุดดิน", "Snap")
